# Latium AI Environment Variables
PROJECT_NAME="Latium AI"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="insecure-dev-secret-key-change-in-production-use-strong-random-bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL (Host: 5433 mapped to container 5432)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5433
POSTGRES_USER="latium_user"
POSTGRES_PASSWORD="latium_password"
POSTGRES_DB="latium_db"
DATABASE_URL="postgresql+asyncpg://latium_user:latium_password@localhost:5433/latium_db"

# Redis (Host: 6380 mapped to container 6379)
REDIS_HOST="localhost"
REDIS_PORT=6380
REDIS_URL="redis://localhost:6380/0"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://localhost:8001"]
